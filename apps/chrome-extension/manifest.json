{
  "manifest_version": 3,
  "name": "Confucius",
  "version": "0.1.0",
  "description": "Research agent side panel that talks to Confucius for Zotero",
  "action": {
    "default_title": "Confucius",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:23119/*",
    "https://arxiv.org/*",
    "https://*.arxiv.org/*",
    "https://pubmed.ncbi.nlm.nih.gov/*",
    "https://www.biorxiv.org/*",
    "https://doi.org/*",
    "https://scholar.google.com/*",
    "https://scholar.google.com.hk/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/*",
        "https://*.arxiv.org/*",
        "https://pubmed.ncbi.nlm.nih.gov/*",
        "https://www.biorxiv.org/*",
        "https://doi.org/*",
        "https://scholar.google.com/*",
        "https://scholar.google.com.hk/*"
      ],
      "js": ["content-script.js"]
    }
  ]
}
