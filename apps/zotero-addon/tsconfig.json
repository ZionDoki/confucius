{
  "extends": "zotero-types/entries/sandbox/",
  "compilerOptions": {
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "composite": false
  },
  "include": ["src", "typings"],
  "exclude": ["build", "addon", ".scaffold"]
}
