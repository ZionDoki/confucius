# Copy this file as `.env` next to zotero-plugin.config.ts.

# Path to the Zotero binary. Forward slashes work on Windows.
# macOS: /Applications/Zotero.app/Contents/MacOS/zotero
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=C:/Program Files/Zotero/zotero.exe

# Optional: a dedicated development profile.
# Create one with: /path/to/zotero.exe -p
# ZOTERO_PLUGIN_PROFILE_PATH=

# Optional: custom data directory. Empty uses Zotero default.
# ZOTERO_PLUGIN_DATA_DIR=
