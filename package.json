{
  "name": "confucius",
  "version": "0.1.0",
  "private": true,
  "description": "Native research agent for Zotero, with a Chrome bridge",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=@confucius/zotero-addon",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run sync-skills --silent && npm test --workspaces --if-present",
    "sync-skills": "node scripts/sync-skills.mjs",
    "sync-skills:check": "node scripts/sync-skills.mjs --check",
    "package:chrome": "node scripts/package-chrome.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf"
  }
}
